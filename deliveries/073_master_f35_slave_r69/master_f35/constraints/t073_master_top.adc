# t073_master_top 引脚: SD 六线按 T28 确认球脚(CLK=A14 CMD=A13 D0=B14 D1=B15 D2=A11 D3=A12)
set_pin_assignment {clk_50m} { LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {rst_n}   { LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sd_clk}    { LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {sd_cmd}    { LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment {sd_dat[0]} { LOCATION = B14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {sd_dat[1]} { LOCATION = B15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {sd_dat[2]} { LOCATION = A11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {sd_dat[3]} { LOCATION = A12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {led[0]} { LOCATION = A4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {led[1]} { LOCATION = A3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {led[2]} { LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {led[3]} { LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

set_pin_assignment {HDMI_CLK_P} { LOCATION = C3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_D0_P}  { LOCATION = G5; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_D1_P}  { LOCATION = F1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_D2_P}  { LOCATION = E1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_DDC_SCL} { LOCATION = P2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment {HDMI_DDC_SDA} { LOCATION = R2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

set_pin_assignment {sw[0]} { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sw[1]} { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sw[2]} { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sw[3]} { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

set_pin_assignment {key2_n} { LOCATION = B2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {key3_n} { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {key4_n} { LOCATION = C1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment {c1_tx_data} { LOCATION = B3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {c1_rx_data} { LOCATION = F5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {c1_d3_low} { LOCATION = D3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {c1_e3_low} { LOCATION = E3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {c1_e4_low} { LOCATION = E4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {c1_k1_low} { LOCATION = K1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
