// ============================================================================
// nn_scaler_table.vh — [task_043 P2a] 31 态动画表(由 sim/gen_p2a_table.py 生成;
//   勿手改 — 重跑生成器再粘贴。规则见该脚本头注释: t=缓入缓出, w 吸附 4 的
//   倍数(4:3 恒成立), S=round(640*2^12/w) 定点步长(x/y 同), 端点态由 RTL 切
//   mapper 块公式精确对齐, 中间态 = (lx*S+2048)>>12 最近邻。
// ============================================================================
localparam integer NSC_FRAC = 12;

// {w_k[9:0], S_k[13:0]} 逐态(24b; w≤640 需 10b, S≤8192 需 14b)
// case 函数形式: 利于综合器 ROM/DRAM 推断(三元和译码实测 579 LUT 超预算)
function [23:0] nsc_tab;
    input [4:0] k;
    begin
        case (k)
            5'd0: nsc_tab = {10'd320, 14'd8192};   // h=240
            5'd1: nsc_tab = {10'd320, 14'd8192};   // h=240
            5'd2: nsc_tab = {10'd324, 14'd8091};   // h=243
            5'd3: nsc_tab = {10'd328, 14'd7992};   // h=246
            5'd4: nsc_tab = {10'd332, 14'd7896};   // h=249
            5'd5: nsc_tab = {10'd340, 14'd7710};   // h=255
            5'd6: nsc_tab = {10'd352, 14'd7447};   // h=264
            5'd7: nsc_tab = {10'd360, 14'd7282};   // h=270
            5'd8: nsc_tab = {10'd372, 14'd7047};   // h=279
            5'd9: nsc_tab = {10'd384, 14'd6827};   // h=288
            5'd10: nsc_tab = {10'd400, 14'd6554};   // h=300
            5'd11: nsc_tab = {10'd416, 14'd6302};   // h=312
            5'd12: nsc_tab = {10'd432, 14'd6068};   // h=324
            5'd13: nsc_tab = {10'd448, 14'd5851};   // h=336
            5'd14: nsc_tab = {10'd464, 14'd5650};   // h=348
            5'd15: nsc_tab = {10'd480, 14'd5461};   // h=360
            5'd16: nsc_tab = {10'd496, 14'd5285};   // h=372
            5'd17: nsc_tab = {10'd512, 14'd5120};   // h=384
            5'd18: nsc_tab = {10'd528, 14'd4965};   // h=396
            5'd19: nsc_tab = {10'd544, 14'd4819};   // h=408
            5'd20: nsc_tab = {10'd560, 14'd4681};   // h=420
            5'd21: nsc_tab = {10'd576, 14'd4551};   // h=432
            5'd22: nsc_tab = {10'd588, 14'd4458};   // h=441
            5'd23: nsc_tab = {10'd600, 14'd4369};   // h=450
            5'd24: nsc_tab = {10'd608, 14'd4312};   // h=456
            5'd25: nsc_tab = {10'd620, 14'd4228};   // h=465
            5'd26: nsc_tab = {10'd628, 14'd4174};   // h=471
            5'd27: nsc_tab = {10'd632, 14'd4148};   // h=474
            5'd28: nsc_tab = {10'd636, 14'd4122};   // h=477
            5'd29: nsc_tab = {10'd640, 14'd4096};   // h=480
            5'd30: nsc_tab = {10'd640, 14'd4096};   // h=480
            default: nsc_tab = {10'd640, 14'd4096};
        endcase
    end
endfunction
wire [23:0] nsc_w_s = nsc_tab(k);
