        mirrored = 12'd0-k;
        if (k <= 1024) fft_sin_q15 = fft_qsin_quadrant(k[10:0]);
        else if (k < 2048) fft_sin_q15 = fft_qsin_quadrant(mirrored[10:0]);
        else if (k <= 3072) fft_sin_q15 = -fft_qsin_quadrant(k[10:0]);
        else fft_sin_q15 = -fft_qsin_quadrant(mirrored[10:0]);
    end
endfunction

function automatic signed [15:0] fft_cos_q15(input [11:0] index);
    begin
