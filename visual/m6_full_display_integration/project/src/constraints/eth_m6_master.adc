# ============================================================================
# eth_pcm.adc — task_052 双板以太网 PCM 探针引脚约束 (EG4S20BG256, HX4S20C)
# 主从两颗 bit 共用同一份引脚约束(两板同型号, 差别只在顶层与 bit 文件)。
#
# 引脚来源分级(见 doc/output/LINK_REPORT.md §E0 证据表):
#   [A] 官方例程 ph1_demo.adc 原文(lab_ex_1_ethernet_led / lab_ex_4 两份一致):
#       clk_50=R7, RGMII 12 脚, key1=B2, key2=B1, dled[15:0], led_data[3:0]
#   [!] RGMII 12 脚本包用 LVCMOS33, 不是官方 33_..._final_1000 的 LVCMOS25。
#       原因(实测, 记此防复发): TD 的 IO 合法性检查直接报
#       "USR-8001 ERROR: Design contains multiple IOSTANDARD setups on bank 0",
#       即同一 bank 不允许混用两种电平; 而 LED/按键/拨码脚与 RGMII 脚在 TD 的
#       bank 划分里同组, 那些脚必须保持 LVCMOS33(task_043 主线在板上长期验证的
#       电平)。两份官方例程各自整份统一(旧版全 33, 新版全 25), 本包取与主线
#       一致的 33。板上 PHY 的 RGMII 域由 SELRGV(R79 4.75k 接地)配成 DVDD25
#       =2.5V, 因此"3.3V bank 读 2.5V 信号"是已知且沿用例程的电平偏差, 列入
#       LINK_REPORT 的待实测项(若 RX 侧稳定出错而采样相位已排除, 下一步试整份
#       LVCMOS25 的对照 bit)。
#   [A] 本主线已上板核对过的同名映射(task_043 m1a_top.adc):
#       led[0]=A4 / led[1]=A3 / led[2]=C10 / led[3]=B12 (高电平点亮),
#       sw[0..3]=C8/C7/C6/C5 (SPEC 原文顺序, 043 步①曾因写反序被上板纠正),
#       第三按键 key3=C1(043 key_auto 实测可用), 全部按键 PULLTYPE=PULLUP
#   [X] 未使用且不约束: MDC/MDIO(手册给 L13/M13, 官方例程从未引到 pad, 电气
#       未核实, 本 bit 不使用), PHYRSTB(板上 R80 4.75k+C81 4.7uF 的 RC 复位,
#       无 FPGA 驱动脚, 官方顶层的 phy_reset 端口是悬空产物)
#
# 注意: LED/dled 的位序按 task_043 上板纠正后的约定; 首颗 bit 上板需用
# 读数页 7(tx_frames, dled[0] 翻得最快)确认 dled 位序方向, 若与丝印相反
# 只需在顶层把 dled 反序, 不改逻辑。
# ============================================================================

# ---- 板载 50MHz 晶振(经 R115 33Ω 到 FPGA_GCLK) ----
set_pin_assignment {clk_50}                { LOCATION = R7;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ---- RGMII 接收(全部为输入, 无 DRIVESTRENGTH/SLEWRATE) ----
set_pin_assignment {phy1_rgmii_rx_clk}     { LOCATION = T14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {phy1_rgmii_rx_ctl}     { LOCATION = T13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {phy1_rgmii_rx_data[0]} { LOCATION = P6;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {phy1_rgmii_rx_data[1]} { LOCATION = M6;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {phy1_rgmii_rx_data[2]} { LOCATION = T9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {phy1_rgmii_rx_data[3]} { LOCATION = N9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ---- RGMII 发送(全部为输出, 官方原文 DRIVESTRENGTH=16 / SLEWRATE=FAST) ----
set_pin_assignment {phy1_rgmii_tx_clk}     { LOCATION = T12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment {phy1_rgmii_tx_ctl}     { LOCATION = T7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment {phy1_rgmii_tx_data[0]} { LOCATION = T4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment {phy1_rgmii_tx_data[1]} { LOCATION = T6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment {phy1_rgmii_tx_data[2]} { LOCATION = M7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment {phy1_rgmii_tx_data[3]} { LOCATION = T8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }

# ---- 按键(低有效, 板上拉; 内置 2ms 去抖后使用) ----
set_pin_assignment {key1}                  { LOCATION = B2;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {key2}                  { LOCATION = B1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment {key3}                  { LOCATION = C1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- 拨码 sw[0]=SW1 ... sw[3]=SW4 (task_043 上板纠正后的顺序) ----
set_pin_assignment {sw[0]}                 { LOCATION = C8;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sw[1]}                 { LOCATION = C7;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sw[2]}                 { LOCATION = C6;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sw[3]}                 { LOCATION = C5;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ---- 状态 LED: 高电平点亮, led[0] 为最低位 ----
set_pin_assignment {led[0]}                { LOCATION = A4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {led[1]}                { LOCATION = A3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {led[2]}                { LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {led[3]}                { LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# ---- 16 位读数 LED(dled[0] = 最低位, 读数表见 LINK_REPORT §dled) ----
set_pin_assignment {dled[0]}               { LOCATION = C15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[1]}               { LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[2]}               { LOCATION = B6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[3]}               { LOCATION = A5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[4]}               { LOCATION = B5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[5]}               { LOCATION = A8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[6]}               { LOCATION = A7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[7]}               { LOCATION = A6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[8]}               { LOCATION = F16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[9]}               { LOCATION = E16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[10]}              { LOCATION = E12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[11]}              { LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[12]}              { LOCATION = C13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[13]}              { LOCATION = F10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[14]}              { LOCATION = E11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {dled[15]}              { LOCATION = D11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

set_pin_assignment {sd_dclk} { LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {sd_miso} { LOCATION = B14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment {sd_mosi} { LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {sd_ncs} { LOCATION = A12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment {HDMI_CLK_P} { LOCATION = C3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_D2_P}  { LOCATION = E1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_D1_P}  { LOCATION = F1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_D0_P}  { LOCATION = G5; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment {HDMI_DDC_SCL} { LOCATION = P2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment {HDMI_DDC_SDA} { LOCATION = R2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
